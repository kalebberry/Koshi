  <!-- Interactive Responsive Preview Script -->
  <script>
    const stylesheetLinks = Array.from(
      document.querySelectorAll<HTMLLinkElement | HTMLStyleElement>('link[rel="stylesheet"], style')
    )
      .map((node) => (node instanceof HTMLLinkElement ? `<link rel="stylesheet" href="${node.href}">` : node.outerHTML))
      .join('');

    document.querySelectorAll<HTMLElement>('[data-browser-preview]').forEach((preview) => {
      const frame = preview.querySelector<HTMLIFrameElement>('[data-preview-iframe]');
      const canvas = preview.querySelector<HTMLElement>('[data-preview-canvas]');
      const switcher = preview.querySelector<HTMLElement>('.browser-preview__viewport-switcher');
      if (!frame || !canvas) return;

      const resizeFrame = () => {
        try {
          const doc = frame.contentDocument || frame.contentWindow?.document;
          if (doc?.body) {
            frame.style.height = (doc.body.scrollHeight + 36) + 'px';
          }
        } catch (e) {}
      };

      frame.onload = resizeFrame;
      frame.srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">${stylesheetLinks}<style>html,body{margin:0;padding:0;background:#f7f5f0;min-width:0;overflow-x:hidden}body{padding:clamp(16px,3vw,36px) clamp(12px,2.5vw,28px)}</style></head><body>${canvas.innerHTML}</body></html>`;

      canvas.style.display = 'none';

      if (switcher) {
        switcher.querySelectorAll<HTMLButtonElement>('.view-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            switcher.querySelectorAll('.view-btn').forEach((b) => b.classList.remove('view-btn--active'));
            btn.classList.add('view-btn--active');
            frame.style.width = btn.dataset.view || '100%';
            setTimeout(resizeFrame, 350);
          });
        });
      }
    });
  </script>
