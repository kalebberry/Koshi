  <!-- Interactive Responsive Preview Script -->
  <script>
    const stylesheetLinks = Array.from(
      document.querySelectorAll<HTMLLinkElement | HTMLStyleElement>('link[rel="stylesheet"], style')
    )
      .map((node) => (node instanceof HTMLLinkElement ? `<link rel="stylesheet" href="${node.href}">` : node.outerHTML))
      .join('');

    document.querySelectorAll<HTMLElement>('[data-browser-preview]').forEach((preview) => {
      const frame = preview.querySelector<HTMLIFrameElement>('[data-preview-iframe]');
      const canvas = preview.querySelector<HTMLElement>('[data-preview-canvas]');
      const switcher = preview.querySelector<HTMLElement>('.browser-preview__viewport-switcher');
      if (!frame || !canvas) return;

      const updateHeight = () => {
        try {
          const doc = frame.contentDocument || frame.contentWindow?.document;
          if (!doc) return;
          const root = doc.querySelector<HTMLElement>('[data-canvas-root]');
          if (!root) return;
          const h = Math.ceil(root.getBoundingClientRect().height);
          if (h > 0) {
            frame.style.height = `${h}px`;
          }
        } catch (e) {}
      };

      const setupObserver = () => {
        try {
          const doc = frame.contentDocument || frame.contentWindow?.document;
          if (!doc) return;
          const root = doc.querySelector<HTMLElement>('[data-canvas-root]');
          if (!root) return;

          updateHeight();

          const win = frame.contentWindow || window;
          if (win.ResizeObserver) {
            const ro = new win.ResizeObserver(() => {
              updateHeight();
            });
            ro.observe(root);
          }

          if (doc.fonts?.ready) {
            doc.fonts.ready.then(updateHeight);
          }
        } catch (e) {}
      };

      frame.addEventListener('load', setupObserver);

      frame.srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">${stylesheetLinks}<style>*,*::before,*::after{box-sizing:border-box}html{margin:0;padding:0;background:#f7f5f0;overflow:hidden}body{margin:0;padding:0;background:transparent;overflow:hidden;min-height:0;height:auto}.preview-canvas-root{display:flow-root;padding:clamp(16px,2.5vw,32px) clamp(12px,2vw,24px);width:100%;box-sizing:border-box;min-height:0;height:auto}</style></head><body><div class="preview-canvas-root" data-canvas-root>${canvas.innerHTML}</div></body></html>`;

      canvas.style.display = 'none';

      if (switcher) {
        switcher.querySelectorAll<HTMLButtonElement>('.view-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            switcher.querySelectorAll('.view-btn').forEach((b) => b.classList.remove('view-btn--active'));
            btn.classList.add('view-btn--active');
            frame.style.width = btn.dataset.view || '100%';
            updateHeight();
            setTimeout(updateHeight, 320);
          });
        });
      }

      frame.addEventListener('transitionend', (e) => {
        if (e.propertyName === 'width') {
          updateHeight();
        }
      });
    });
  </script>
