---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Structure with intention"
  description="Kōshi is a lightweight, dependency-free CSS grid system for thoughtful responsive layouts. Explore the documentation, tutorial, and interactive Composition Lab."
>
  <div class="shell">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-header-bar">
        <span class="eyebrow">A modern CSS grid system — <span lang="ja">格子</span></span>
        <button
          type="button"
          class="lattice-toggle-btn"
          data-lattice-toggle
          aria-pressed="false"
          aria-label="Toggle 12-Track Lattice Grid Overlay"
        >
          <span class="toggle-icon">⊞</span>
          <span class="toggle-text">Toggle 12-Track Lattice</span>
        </button>
      </div>

      <div class="kos-grid hero-grid" kos-cols="12">
        <div class="hero-main" kos-col-span="8">
          <h1 class="display">Structure<br /><em>with intention.</em></h1>
          <p class="lead">
            A lightweight, flexible CSS grid system for crafting thoughtful, responsive layouts.
            Built on CSS Grid Level 2, Subgrid, and Japanese spatial proportions.
            No framework required. Just CSS, proportion, and room to experiment.
          </p>
          <div class="actions">
            <a class="action action-primary" href="/docs/">Get started ↗</a>
            <a class="action action-outline" href="/docs/tutorial/">Tutorial ★</a>
            <a class="action action-outline" href="/lab/">Explore the Lab ↗</a>
            <a class="action action-ghost" href="/downloads/koshi.css" download="koshi.css">Download CSS ↓</a>
          </div>
        </div>

        <div class="hero-aside" kos-col-span="4">
          <div class="hero-specimen-card">
            <div class="specimen-card-header">
              <span class="specimen-tag">0.00 KB RUNTIME</span>
              <span class="specimen-lattice-state">12 TRACKS ACTIVE</span>
            </div>
            <div class="specimen-diagram" aria-hidden="true">
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
              <div class="diag-col"></div>
            </div>
            <div class="specimen-card-body">
              <div class="specimen-concept">
                <strong>Yohaku 余白</strong>
                <span>The intentional beauty of breathing negative space.</span>
              </div>
              <div class="specimen-metrics">
                <div>
                  <span class="metric-val">12</span>
                  <span class="metric-lbl">Columns</span>
                </div>
                <div>
                  <span class="metric-val">100%</span>
                  <span class="metric-lbl">Native CSS</span>
                </div>
                <div>
                  <span class="metric-val">0</span>
                  <span class="metric-lbl">Dependencies</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 / The System & Interactive Ratio Selector -->
    <section class="section-container" aria-labelledby="system-title">
      <div class="section-label">
        <span class="eyebrow">01 / THE SYSTEM</span>
        <span class="eyebrow">12 COLUMNS · DELIBERATE PROPORTIONS</span>
      </div>
      <h2 id="system-title" class="section-title">An underlying rhythm.</h2>
      <p class="lead">
        Start with twelve tracks. Divide the space into deliberate proportions, or let an intrinsic grid respond to the room. Click any proportion below to see the lattice rebalance in real time.
      </p>

      <!-- Ratio Selector Pills -->
      <div class="ratio-selector-container" data-ratio-selector>
        <span class="ratio-selector-label">Select Proportion:</span>
        <div class="ratio-pills">
          <button type="button" class="ratio-pill" data-ratio="8-4" aria-pressed="true">8 + 4 (Editorial)</button>
          <button type="button" class="ratio-pill" data-ratio="7-5" aria-pressed="false">7 + 5 (Golden Ratio)</button>
          <button type="button" class="ratio-pill" data-ratio="4-4-4" aria-pressed="false">4 + 4 + 4 (Triptych)</button>
          <button type="button" class="ratio-pill" data-ratio="6-6" aria-pressed="false">6 + 6 (Diptych)</button>
          <button type="button" class="ratio-pill" data-ratio="3-6-3" aria-pressed="false">3 + 6 + 3 (Focus Chamber)</button>
        </div>
      </div>

      <div class="grid-demonstration">
        <div class="demo-meta">
          <span>GRID / 12 COLUMNS</span>
          <span class="demo-formula" data-ratio-formula>8 + 4 = 12</span>
        </div>
        <div class="demo-grid" data-demo-grid aria-label="12-column interactive proportion demonstration">
          <div class="feature" kos-col-span="8" style="grid-column: span 8;">
            <div class="col-spec">
              <span class="col-num">08 / 12</span>
              <span class="col-desc">Primary Content</span>
            </div>
          </div>
          <div class="aside" kos-col-span="4" style="grid-column: span 4;">
            <div class="col-spec">
              <span class="col-num">04 / 12</span>
              <span class="col-desc">Supporting Space</span>
            </div>
          </div>
        </div>

        <div class="demo-code-wrapper">
          <div class="demo-code-header">
            <span>CORRESPONDING KŌSHI HTML MARKUP</span>
            <span>PURE CSS GRID LEVEL 2</span>
          </div>
          <pre class="code-sample demo-code"><code data-ratio-code>{`<div class="kos-grid" kos-cols="12">
  <main kos-col-span="8">Primary Content</main>
  <aside kos-col-span="4">Supporting Space</aside>
</div>`}</code></pre>
        </div>
      </div>
    </section>

    <!-- 02 / Spatial Specimen Strip (Live Compositions) -->
    <section class="section-container" aria-labelledby="specimens-title">
      <div class="section-label">
        <span class="eyebrow">02 / SPATIAL SPECIMENS</span>
        <span class="eyebrow">LIVE ARCHETYPES IN CONTEXT</span>
      </div>
      <div class="section-head-split">
        <div>
          <h2 id="specimens-title" class="section-title">Proportions that breathe.</h2>
          <p class="lead">
            Every archetype in Kōshi is engineered with mathematical poise. Experience how three foundational layouts respond dynamically to the viewport.
          </p>
        </div>
        <div class="section-head-action">
          <a class="action action-outline" href="/lab/">Browse all 72 Compositions ↗</a>
        </div>
      </div>

      <div class="specimens-list">
        <!-- Specimen A: Asymmetric Cinema Hero (7:5) -->
        <article class="specimen-card">
          <div class="specimen-card-meta">
            <span class="specimen-num">SPECIMEN 01 / CINEMA ARCHETYPE</span>
            <span class="specimen-formula">7 + 5 ASYMMETRIC CINEMA HERO</span>
          </div>
          <div class="specimen-live-stage">
            <div class="kos-grid specimen-cinema" kos-cols="12">
              <div class="cinema-content" kos-col-span="7">
                <span class="mini-tag">GINKAKU-JI MONOGRAPH</span>
                <h3 class="cinema-title">The silver pavilion, moonlit sand, and pine shadow.</h3>
                <p class="cinema-body">
                  In 1482, Ashikaga Yoshimasa withdrew to Kyoto’s eastern mountains. Rather than overwhelming stone, the pavilion breathes through deliberate asymmetry and quiet light.
                </p>
                <div class="cinema-link">Read monograph ↗</div>
              </div>
              <div class="cinema-plate" kos-col-span="5">
                <div class="plate-inner">
                  <div class="plate-accent">05 / 12</div>
                  <span class="plate-label">VISUAL PLATE</span>
                </div>
              </div>
            </div>
          </div>
          <div class="specimen-footer">
            <code>&lt;div class="kos-grid" kos-cols="12"&gt; &lt;div kos-col-span="7"&gt; ... &lt;div kos-col-span="5"&gt;</code>
          </div>
        </article>

        <!-- Specimen B: Bento Mosaic (Multi-row spans) -->
        <article class="specimen-card">
          <div class="specimen-card-meta">
            <span class="specimen-num">SPECIMEN 02 / BENTO ARCHETYPE</span>
            <span class="specimen-formula">8:4 MULTI-ROW BENTO MOSAIC</span>
          </div>
          <div class="specimen-live-stage">
            <div class="kos-grid specimen-bento" kos-cols="12">
              <div class="bento-hero" kos-col-span="8" kos-row-span="2">
                <span class="mini-tag">PRIMARY ANCHOR · SPAN 8 × 2</span>
                <h4>Modular harmony through 2D grid cells</h4>
                <p>Grid rows combine seamlessly with column spans without negative margin gymnastics.</p>
                <div class="bento-badge">Multi-Row Span 2</div>
              </div>
              <div class="bento-card" kos-col-span="4">
                <span class="metric-num">0.00 KB</span>
                <span class="metric-desc">Zero JavaScript runtime</span>
              </div>
              <div class="bento-card bento-card-sub" kos-col-span="4">
                <span class="metric-num">12 Tracks</span>
                <span class="metric-desc">Pure fractional calculation</span>
              </div>
            </div>
          </div>
          <div class="specimen-footer">
            <code>&lt;div kos-col-span="8" kos-row-span="2"&gt; &lt;div kos-col-span="4"&gt; ...</code>
          </div>
        </article>

        <!-- Specimen C: Synchronized Subgrid Card Triad (4:4:4) -->
        <article class="specimen-card">
          <div class="specimen-card-meta">
            <span class="specimen-num">SPECIMEN 03 / SUBGRID ARCHETYPE</span>
            <span class="specimen-formula">4 + 4 + 4 SYNCHRONIZED BASES (CSS SUBGRID)</span>
          </div>
          <div class="specimen-live-stage">
            <div class="kos-grid specimen-subgrid" kos-cols="12">
              <div class="subgrid-card" kos-col-span="4" kos-subgrid="rows">
                <span class="card-kicker">01 / DISCIPLINE</span>
                <h4 class="card-head">Direct Column Math</h4>
                <p class="card-desc">No percentage rounding drift or broken fractional margins across screen sizes.</p>
                <button type="button" class="card-action">Learn more</button>
              </div>
              <div class="subgrid-card" kos-col-span="4" kos-subgrid="rows">
                <span class="card-kicker">02 / EXTENSION</span>
                <h4 class="card-head">Subgrid Alignment</h4>
                <p class="card-desc">Headings, text blocks, and buttons align row-by-row across columns effortlessly with true CSS subgrid.</p>
                <button type="button" class="card-action">Learn more</button>
              </div>
              <div class="subgrid-card" kos-col-span="4" kos-subgrid="rows">
                <span class="card-kicker">03 / HARMONY</span>
                <h4 class="card-head">Fluid Yohaku</h4>
                <p class="card-desc">Offsets and empty tracks participate natively in layout flow without fragile spacer DOM nodes.</p>
                <button type="button" class="card-action">Learn more</button>
              </div>
            </div>
          </div>
          <div class="specimen-footer">
            <code>&lt;div class="kos-grid" kos-cols="12"&gt; &lt;div kos-col-span="4" kos-subgrid="rows"&gt;</code>
          </div>
        </article>
      </div>
    </section>

    <!-- 03 / Paradigm Shift: Why Kōshi? -->
    <section class="section-container" aria-labelledby="paradigm-title">
      <div class="section-label">
        <span class="eyebrow">03 / PARADIGM SHIFT</span>
        <span class="eyebrow">WHY THE WEB OUTGREW 2010s GRIDS</span>
      </div>
      <h2 id="paradigm-title" class="section-title">The architectural shift.</h2>
      <p class="lead">
        For over a decade, frontend teams wrestled with negative margins, percentage rounding bugs, and bloated utility classes. Kōshi represents the modern foundation built for CSS Grid Level 2.
      </p>

      <div class="matrix-wrapper">
        <table class="comparison-matrix" aria-label="Comparison between legacy CSS grid frameworks and Kōshi">
          <thead>
            <tr>
              <th scope="col" class="th-aspect">ARCHITECTURAL CRITERIA</th>
              <th scope="col" class="th-legacy">LEGACY 12-COL (2011–2020)</th>
              <th scope="col" class="th-koshi">KŌSHI (CSS GRID LEVEL 2)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="matrix-criterion">
                <strong>Gutter Management</strong>
                <span>Spacing between column tracks</span>
              </th>
              <td class="legacy-cell">
                <span class="status-cross">✕</span>
                Negative row margins (<code>margin: 0 -15px</code>) and column padding. Prone to horizontal scrollbar overflows.
              </td>
              <td class="koshi-cell">
                <span class="status-check">✓</span>
                Native <code>gap: var(--kos-gutter)</code>. Zero negative margins, zero outer container overflow bugs.
              </td>
            </tr>
            <tr>
              <th scope="row" class="matrix-criterion">
                <strong>Track Precision</strong>
                <span>Sub-pixel rendering across Retina displays</span>
              </th>
              <td class="legacy-cell">
                <span class="status-cross">✕</span>
                Percentage widths (<code>33.333333%</code>, <code>8.333333%</code>). Causes 1px wrapping drops on high-DPI viewports.
              </td>
              <td class="koshi-cell">
                <span class="status-check">✓</span>
                Native fractional <code>fr</code> units computed by the browser layout engine with zero rounding jitter.
              </td>
            </tr>
            <tr>
              <th scope="row" class="matrix-criterion">
                <strong>Multi-Row Baseline Synchronization</strong>
                <span>Aligning buttons and headers across sibling cards</span>
              </th>
              <td class="legacy-cell">
                <span class="status-cross">✕</span>
                Impossible without JavaScript plugins (e.g. <code>matchHeight.js</code>) or awkward fixed heights.
              </td>
              <td class="koshi-cell">
                <span class="status-check">✓</span>
                True <code>subgrid</code> inheritance (<code>kos-subgrid="rows"</code>). Baselines lock across all columns natively.
              </td>
            </tr>
            <tr>
              <th scope="row" class="matrix-criterion">
                <strong>Negative Space (Yohaku)</strong>
                <span>Offsets and empty track positioning</span>
              </th>
              <td class="legacy-cell">
                <span class="status-cross">✕</span>
                Fragile <code>offset-md-4</code> classes using <code>margin-left: %</code>, breaking if elements wrap.
              </td>
              <td class="koshi-cell">
                <span class="status-check">✓</span>
                Explicit <code>kos-col-start</code> or natural track placement that preserves structural grid integrity.
              </td>
            </tr>
            <tr>
              <th scope="row" class="matrix-criterion">
                <strong>Bundle Weight & Runtime</strong>
                <span>Cost shipped to client devices</span>
              </th>
              <td class="legacy-cell">
                <span class="status-cross">✕</span>
                50 KB – 150 KB bloated SCSS/JS bundles with thousands of utility classes and pre-processors.
              </td>
              <td class="koshi-cell">
                <span class="status-check">✓</span>
                <strong>0.00 KB JavaScript</strong>. Pure, elegant, standard CSS that works out of the box in any framework.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 04 / The Kōshi Ecosystem -->
    <section class="section-container" aria-labelledby="explore-title">
      <div class="section-label">
        <span class="eyebrow">04 / THE ECOSYSTEM</span>
        <span class="eyebrow">FOUR PILLARS OF FORM</span>
      </div>
      <h2 id="explore-title" class="section-title">Explore the craft.</h2>
      <div class="ecosystem-links">
        <a class="ecosystem-card" href="/docs/tutorial/">
          <div class="card-top">
            <span class="number">01 / MASTERCLASS</span>
            <span class="card-badge">TUTORIAL ★</span>
          </div>
          <div class="card-content">
            <h3>Editorial Tutorial ↗</h3>
            <p>Learn spatial rhythm, intentional Yohaku, and CSS subgrid through 5 authentic Kyoto architectural garden studies.</p>
          </div>
          <div class="card-bottom">
            <span>5 Interactive Case Studies →</span>
          </div>
        </a>

        <a class="ecosystem-card" href="/lab/">
          <div class="card-top">
            <span class="number">02 / WORKSHOP</span>
            <span class="card-badge">LAB 2.0</span>
          </div>
          <div class="card-content">
            <h3>Composition Lab ↗</h3>
            <p>72 curated layout studies spanning Bento, Cinema, Editorial, Gallery, and Subgrid archetypes. Ready to inspect and copy.</p>
          </div>
          <div class="card-bottom">
            <span>72 Pure Spatial Compositions →</span>
          </div>
        </a>

        <a class="ecosystem-card" href="/docs/">
          <div class="card-top">
            <span class="number">03 / REFERENCE</span>
            <span class="card-badge">DOCS</span>
          </div>
          <div class="card-content">
            <h3>Documentation ↗</h3>
            <p>Understand columns, spans, gutters, offsets, dense auto-flow packing, and fluid responsive compositions.</p>
          </div>
          <div class="card-bottom">
            <span>Complete API & Syntax Guide →</span>
          </div>
        </a>

        <a class="ecosystem-card" href="/downloads/koshi.css" download="koshi.css">
          <div class="card-top">
            <span class="number">04 / STANDALONE</span>
            <span class="card-badge">PURE CSS</span>
          </div>
          <div class="card-content">
            <h3>Download Kōshi ↓</h3>
            <p>Direct standalone CSS file. Zero build steps, zero npm packages required. Drop into Astro, Next.js, or raw HTML.</p>
          </div>
          <div class="card-bottom">
            <span>Direct CSS Download ↓</span>
          </div>
        </a>
      </div>
    </section>

    <!-- 05 / Get Started -->
    <section class="start-section" aria-labelledby="start-title">
      <div class="section-label">
        <span class="eyebrow">05 / GET STARTED</span>
        <span class="eyebrow">PLAIN HTML + CSS</span>
      </div>
      <h2 id="start-title" class="section-title">Start with the grid.</h2>
      <pre class="code-sample"><code>{`<link rel="stylesheet" href="/css/koshi.css" />

<div class="kos-grid" kos-cols="12">
  <main kos-col-span="8">Your primary content</main>
  <aside kos-col-span="4">A supporting space</aside>
</div>`}</code></pre>
      <div class="actions">
        <a class="action action-primary" href="/docs/">Read the documentation ↗</a>
        <a class="action action-outline" href="/docs/tutorial/">Start the tutorial ★</a>
      </div>
    </section>
  </div>

  <script>
    import '../scripts/ratio-selector';
  </script>
</SiteLayout>
