---
import '../styles/koshi.css';
import '../styles/index.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Kōshi is a lightweight CSS grid system for intentional, responsive layouts.',
} = Astro.props;

const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    <title>{title} — Kōshi 格子</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Global 12-Track Lattice Visualizer Overlay -->
    <div class="kos-global-lattice" id="global-lattice" aria-hidden="true">
      <div class="shell">
        <div class="lattice-track-grid">
          <div class="lattice-col"><span>01</span></div>
          <div class="lattice-col"><span>02</span></div>
          <div class="lattice-col"><span>03</span></div>
          <div class="lattice-col"><span>04</span></div>
          <div class="lattice-col"><span>05</span></div>
          <div class="lattice-col"><span>06</span></div>
          <div class="lattice-col"><span>07</span></div>
          <div class="lattice-col"><span>08</span></div>
          <div class="lattice-col"><span>09</span></div>
          <div class="lattice-col"><span>10</span></div>
          <div class="lattice-col"><span>11</span></div>
          <div class="lattice-col"><span>12</span></div>
        </div>
      </div>
    </div>

    <!-- Site Header / Navigation -->
    <header class="site-nav shell">
      <a class="site-brand" href="/" aria-label="Kōshi home">
        <span lang="ja">格子</span>
        <strong>KŌSHI</strong>
      </a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
        <a href="/docs/" aria-current={pathname.startsWith('/docs') && !pathname.startsWith('/docs/tutorial') ? 'page' : undefined}>Documentation</a>
        <a href="/docs/tutorial/" aria-current={pathname.startsWith('/docs/tutorial') ? 'page' : undefined}>Tutorial ★</a>
        <a href="/lab/" aria-current={pathname.startsWith('/lab') ? 'page' : undefined}>Composition Lab</a>
        <a href="https://github.com/kalebberry/koshi" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <!-- Main Content Area -->
    <main id="main">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="site-footer shell">
      <span><span lang="ja">格子</span> — KŌSHI</span>
      <span>AN OPEN-SOURCE PROJECT BY <a href="https://eien.studio" target="_blank" rel="noopener noreferrer">STUDIO EIEN</a></span>
      <span>OPEN SOURCE / <a href="https://github.com/kalebberry/koshi/blob/main/LICENSE">MIT</a></span>
    </footer>

    <script>
      import '../scripts/editorial-motion';
      import '../scripts/code-copy';
      import '../scripts/lattice-overlay';
    </script>
  </body>
</html>
